# .env.example — CodeReviewX
# Copy this file to .env and fill in your real values.
# NEVER commit .env to the repository.
# All values here are placeholders only.

# Application
APP_ENV=local

# Backend Java
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_BASE_URL=http://localhost:8000

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codereviewx
POSTGRES_USER=codereviewx
POSTGRES_PASSWORD=<choose-a-local-password>

# Production RAG
RAG_ENABLED=false
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=<your-embedding-api-key>
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=<your-rerank-api-key>
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_MODEL_MAX_RETRIES=2

# GitHub
# Recommended fine-grained token permissions:
# - Contents: read
# - Pull requests: read/write
# - Metadata: read
GITHUB_TOKEN=<your-github-token>
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_CHANGED_FILES=50
GITHUB_MAX_DIFF_BYTES=512000
GITHUB_PER_FILE_PATCH_MAX_BYTES=20000

# Xiaomi MiMo (never commit real values)
MIMO_PLANNER_API_KEY=<your-planner-key>
MIMO_EXECUTOR_API_KEY=<your-executor-key>
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_TIMEOUT_SECONDS=60
