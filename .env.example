# .env.example — CodeReviewX
# Copy this file to .env and fill in your real values.
# NEVER commit .env to the repository.
# All values here are placeholders only.

# Application
APP_ENV=local

# Backend Java
BACKEND_PORT=8080
CODEREVIEWX_DEPLOYMENT_MODE=self-host

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codereviewx
POSTGRES_USER=codereviewx
POSTGRES_PASSWORD=<choose-a-local-password>

# Production RAG
RAG_ENABLED=true
RAG_REVIEW_PERCENTAGE=100
RAG_FALLBACK_ENABLED=false
RAG_REQUIRE_EVIDENCE=true
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=<your-embedding-api-key>
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=<your-rerank-api-key>
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_MODEL_MAX_RETRIES=2
RAG_WORK_ROOT=/absolute/physical/path/to/codereviewx-rag
RAG_FETCH_DEPTH=50
RAG_MAX_FILE_BYTES=1048576
RAG_MAX_FILES=5000
RAG_MAX_TEXT_BYTES=104857600

# GitHub
# Recommended fine-grained token permissions:
# - Contents: read
# - Pull requests: read/write
# - Metadata: read
GITHUB_TOKEN=<your-github-token>
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_CHANGED_FILES=50
GITHUB_MAX_DIFF_BYTES=512000
GITHUB_PER_FILE_PATCH_MAX_BYTES=20000

# OpenAI-compatible model (never commit real values)
MODEL_PROVIDER=custom
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=<your-model-api-key>
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_COMPLETION_TOKENS=2048
MODEL_PLANNER_MAX_COMPLETION_TOKENS=1024
MODEL_EXECUTOR_MAX_COMPLETION_TOKENS=2048
MODEL_GATEKEEPER_MAX_COMPLETION_TOKENS=384

# Legacy MiMo variables are accepted for migration only.

# Local frontend origin; use a comma-separated list for self-hosted deployments.
CODEREVIEWX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
